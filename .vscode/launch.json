    "version": "0.2.0",
    "configurations": [
        {
            "name": "dupotEasyFlatpak",
            "request": "launch",
            "type": "debugpy",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}/src",
            "envFile": "${workspaceFolder}/.env"
